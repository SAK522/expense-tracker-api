# Copy this file to `.env` and fill in real values for local development.
# `.env` itself is gitignored so your secrets never reach GitHub.

# Local dev uses SQLite by default (leave this commented out).
# In production, set this to your PostgreSQL connection string.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Generate a strong one with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-only-secret-change-me
